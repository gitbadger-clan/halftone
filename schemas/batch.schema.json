{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halftone.gitbadger.com/schemas/batch/1.1.0",
  "title": "Halftone Batch",
  "description": "One document for a set of inspected files: full inspections plus a per-file summary row projected from the evidence. No aggregate score.",
  "type": "object",
  "required": ["schema_version", "tool", "summary", "inspections", "created_at"],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "tool": { "type": "object", "required": ["name", "version"] },
    "summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sha256", "mime", "size_bytes", "statuses", "manifest", "marking"],
        "properties": {
          "path": { "type": "string" },
          "source": { "type": "string", "description": "survival runs: the original file" },
          "transform": { "type": "string", "description": "survival runs: none | jpeg_qN | resize_F | crop_F | png | webp | captured:<label>" },
          "sha256": { "type": "string" },
          "mime": { "type": "string" },
          "size_bytes": { "type": "integer" },
          "statuses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source", "layer", "status"],
              "properties": {
                "source": { "type": "string" },
                "layer": { "enum": ["manifest", "container", "mark", "blind"] },
                "status": { "enum": ["present", "absent", "inconclusive", "not_applicable"] }
              }
            }
          },
          "present": { "type": "array", "items": { "type": "string" } },
          "manifest": {
            "type": "object",
            "properties": {
              "validation_state": { "enum": ["Trusted", "Valid", "Invalid"] },
              "issuer": { "type": "string" },
              "claim_generator": { "type": "string" },
              "digital_source_type": { "type": "array", "items": { "type": "string" } },
              "declares_ai": { "type": "boolean" },
              "remote_manifest_url": { "type": "string" }
            }
          },
          "marking": {
            "type": "object",
            "properties": {
              "digital_source_type": { "type": "array", "items": { "type": "string" } },
              "xmp_packets": { "type": "integer", "minimum": 0 },
              "manifest_container_present": { "type": "boolean" }
            }
          }
        }
      }
    },
    "inspections": {
      "type": "array",
      "items": { "$ref": "https://halftone.gitbadger.com/schemas/verdict/1.1.0" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
