# Reference tool pins for docker/references.dockerfile, one KEY=VALUE per line.
# Change them with `uv run scripts/references.py bump <tool> <value>`, which
# re-collects every stratum with the new image; never edit and commit by hand.
# Written by `references.py init` from the tools on the machine that collected
# the committed strata, so the first collection in the image changes no header.

# uv release
UV_VERSION=0.13.7

# ExifTool release (GitHub tag)
EXIFTOOL_VERSION=13.55

# OpenSSL release
OPENSSL_VERSION=3.5.9

# c2patool crate version
C2PATOOL_VERSION=0.28.4

# Credentio commit
CREDENTIO_COMMIT=ee4078badeea5739b0f0f246dbaea7803382718b

# conformance-public commit (rubrics)
CONFORMANCE_COMMIT=da71a7231fd6c86d308771dbb5557fabc920997a

# Bazelisk release (builds Credentio)
BAZELISK_VERSION=v1.28.1

# Clang/libc++ major version (builds Credentio)
LLVM_VERSION=19
